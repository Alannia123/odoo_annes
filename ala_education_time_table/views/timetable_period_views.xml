<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="timetable_period_view_form" model="ir.ui.view">
        <field name="name">ala.timetable.period.view.form</field>
        <field name="model">ala.timetable.period</field>
        <field name="arch" type="xml">
            <form string="Timetable Period">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <label for="time_from" string="Period Time"/>
                            <div>
                                <field name="time_from" widget="float_time" class="oe_inline"/>
                                -
                                <field name="time_to" widget="float_time" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="timetable_period_view_list" model="ir.ui.view">
        <field name="name">ala.timetable.period.view.list</field>
        <field name="model">ala.timetable.period</field>
        <field name="arch" type="xml">
            <list string="Timetable Period">
                <field name="name"/>
                <field name="time_from" widget="float_time"/>
                <field name="time_to" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="timetable_period_action" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">ala.timetable.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">You haven't created any schedules yet.</p>
        </field>
    </record>
</odoo>
