<odoo>
    <template id="faculty_timetable_preview_template" name="Faculty Timetable Preview">
    <t t-call="web.html_container">
        <t t-call="web.layout">
            <div class="container mt-4 mb-4">
                <h2 style="text-align:center;">
                    <t t-esc="record.name or 'Faculty Timetable'"/>
                </h2>

                <div style="text-align:center; margin-top:20px;">
                    <img t-if="record.pdf_file"
                         t-att-src="'/web/image/ala.education.faculty.timetable/%s/pdf_file' % record.id"
                         style="max-width:100%; height:auto; border:1px solid #ccc; border-radius:8px;"/>
                </div>
            </div>
        </t>
    </t>
</template>
</odoo>