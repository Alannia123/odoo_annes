    <record id="education_timetable_schedule_action" model="ir.actions.act_window">
        <field name="name">Timetable Schedule</field>
        <field name="res_model">ala.education.timetable.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_timetable_id': 1, 'search_default_group_week_day': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">You haven't created any schedules yet.</p>
        </field>
    </record>

    <record id="action_education_time_table_view_class_division_wise" model="ir.actions.act_window">
        <field name="name">Timetable Schedule</field>
        <field name="res_model">ala.education.timetable.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="domain">[('class_division_id', '=', active_id)]</field>
        <field name="context">{'search_default_group_class_division': 1, 'search_default_group_week_day': 1}</field>
    </record>

    <record id="action_education_time_table_view_faculty_wise" model="ir.actions.act_window">
        <field name="name">Timetable Schedule</field>
        <field name="res_model">ala.education.timetable.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="domain">[('faculty_id', '=', active_id)]</field>
        <field name="context">{'search_default_group_faculty': 1}</field>
    </record>
</odoo>
