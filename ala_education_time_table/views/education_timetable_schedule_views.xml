<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="education_timetable_schedule_view_form" model="ir.ui.view">
        <field name="name">ala.education.timetable.schedule.view.form</field>
        <field name="model">ala.education.timetable.schedule</field>
        <field name="arch" type="xml">
            <form string="Timetable Schedule">
                <sheet>
                    <group>
                        <group>
                            <field name="period_id"/>
                            <label for="time_from" string="Period Time"/>
                            <div>
                                <field name="time_from" widget="float_time" class="oe_inline"/>
                                -
                                <field name="time_till" widget="float_time" class="oe_inline"/>
                            </div>
                            <field name="subject_id"/>
                            <field name="faculty_id"/>
                        </group>
                        <group>
                            <field name="timetable_id"/>
                            <field name="class_division_id"/>
                            <field name="week_day"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="education_timetable_schedule_view_list" model="ir.ui.view">
        <field name="name">ala.education.timetable.schedule.view.list</field>
        <field name="model">ala.education.timetable.schedule</field>
        <field name="arch" type="xml">
            <list string="Timetable Schedule">
                <field name="period_id"/>
                <field name="time_from" widget="float_time" optional="show"/>
                <field name="time_till" widget="float_time" optional="show"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="timetable_id" optional="show"/>
                <field name="week_day"/>
                <field name="class_division_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

