<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_chatter_sidebar_right_tspl" model="ir.ui.view">
        <field name="name">res.users.form.chatter.sidebar.right.tspl</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']/group/group[@name='other_preferences']" position="inside">
                <field name="chatter_sidebar_right_enabled"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_chatter_sidebar_right_tspl" model="ir.ui.view">
        <field name="name">res.users.preferences.form.chatter.sidebar.right.tspl</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']/group/group[@name='other_preferences']" position="inside">
                <field name="chatter_sidebar_right_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
