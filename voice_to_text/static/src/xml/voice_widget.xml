<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="voice_to_text.VoiceWidget" owl="1">
        <div class="o_field_widget o_field_text o_voice_widget">
            <TextField t-props="props"/>
            <div class="o_voice_input_container">
                <select
                    class="o_voice_lang_select form-select form-select-sm"
                    t-on-change="onLangChange"
                    title="Select Language"
                >
                    <t t-foreach="languages" t-as="lang" t-key="lang.code">
                        <option
                            t-att-value="lang.code"
                            t-att-selected="lang.code === state.selectedLang ? true : undefined"
                        >
                            <t t-esc="lang.name"/>
                        </option>
                    </t>
                </select>

                <VoiceToTextButton
                    record="record"
                    fieldName="props.name"
                    selectedLang="state.selectedLang"
                />

                <button
                    t-if="record.data[props.name]"
                    t-on-click="clearText"
                    type="button"
                    class="btn btn-secondary o_clear_button"
                    title="Clear Text"
                >
                    <i class="fa fa-times"/>
                </button>
            </div>
        </div>
    </t>
</templates>
