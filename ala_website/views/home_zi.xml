<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="ala_home_page" name="St.Anne's Home">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure o_colored_level">
        
        <!-- Inject FontAwesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

        <!-- Hidden JSON Data for Cube -->
        <t t-if="random_images">
          <div id="cube_json_data" t-att-data-json="random_images" style="display:none;"></div>
        </t>

        <!-- ============================================== -->
        <!-- UNIFIED CSS THEME -->
        <!-- ============================================== -->
        <style>
          :root {
            --primary-blue: #0f2c5c;
            --secondary-blue: #1e5aa8;
            --accent-gold: #d4af37;
            --light-bg: #f4f7fa;
            --text-dark: #2c3e50;
          }
          * { box-sizing: border-box; }
          body { font-family: 'Poppins', sans-serif; color: var(--text-dark); }
          h1, h2, h3, h4, h5 { font-family: 'Playfair Display', serif; }

          /* --- Top Running Banner --- */
          .top-banner {
            background: linear-gradient(90deg, var(--primary-blue), var(--secondary-blue));
            color: #fff; padding: 10px 0; overflow: hidden; position: relative;
          }
          .marquee-track {
            display: inline-block; white-space: nowrap; padding-left: 100%;
            animation: scrollLeft 25s linear infinite; font-weight: 600;
          }
          .marquee-track span { margin: 0 30px; color: var(--accent-gold); }
          @keyframes scrollLeft { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }

          /* --- Section Headers --- */
          .event-header-wrapper { width: 100%; display: flex; justify-content: center; margin: 40px 0 30px; }
          .event-header {
            display: inline-flex; align-items: center; gap: 12px; padding: 14px 38px;
            background: var(--primary-blue); border-radius: 50px; color: #fff;
            font-weight: 700; font-size: 26px; letter-spacing: 1.5px;
            box-shadow: 0 4px 15px rgba(15, 44, 92, 0.3);
          }
          .event-icon { font-size: 24px; color: var(--accent-gold); }
          .heading-line { width: 70px; height: 4px; background: var(--accent-gold); margin: 0 auto 30px; border-radius: 2px; }

          /* --- Video  Announcements Split --- */
          .video-split {
            display: flex; max-width: 1400px; margin: 40px auto; border-radius: 20px;
            overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.1); background: #000;
          }
          .video-left { flex: 65%; position: relative; }
          .video-left iframe { width: 100%; height: 100%; min-height: 450px; border: none; }
          .video-overlay {
            position: absolute; bottom: 0; left: 0; width: 100%; padding: 20px 30px;
            background: linear-gradient(transparent, rgba(0,0,0,0.8)); color: #fff;
          }
          
          /* FIXED: Announcement Background */
          .announcements-right {
            flex: 35%; background: #ffffff; padding: 30px;
            display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden;
            box-shadow: -10px 0px 30px rgba(0,0,0,0.1);
          }
          .glass-card {
            background: transparent; backdrop-filter: none;
            border: none; border-radius: 0; padding: 0; color: var(--text-dark);
          }
          .section-title {
            color: var(--primary-blue); font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.5rem;
            margin-bottom: 15px; text-align: center; border-bottom: 2px solid var(--accent-gold);
            display: inline-block; padding-bottom: 5px;
          }
          .scroll-pane { height: 280px; overflow: hidden; position: relative; }
          .scroll-content { position: absolute; width: 100%; animation: scrollUp 20s linear infinite; }
          .scroll-content p { margin-bottom: 15px; font-size: 0.95rem; border-bottom: 1px solid #eee; padding-bottom: 10px; }
          @keyframes scrollUp { 0% { top: 100%; } 100% { top: -100%; } }

          /* --- Hero Title Section --- */
          .hero-section {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
            padding: 80px 20px; text-align: center; position: relative; overflow: hidden;
          }
          .hero-section::before {
            content: ''; position: absolute; top: -50px; right: -50px; width: 300px; height: 300px;
            background: rgba(255,255,255,0.1); border-radius: 50%;
          }
          .hero-title {
            color: #fff; font-size: 3.2rem; max-width: 900px; margin: 0 auto 20px auto; line-height: 1.2;
          }
          .gradient-text {
            background: linear-gradient(90deg, #fff, var(--accent-gold), #fff);
            -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
          }
          .hero-subtitle { color: rgba(255,255,255,0.9); font-size: 1.2rem; font-style: italic; }
          .ai-badge {
            position: absolute; bottom: 15px; right: 15px; background: rgba(0,0,0,0.4);
            backdrop-filter: blur(8px); border-radius: 14px; padding: 8px 16px;
            display: flex; align-items: center; gap: 8px; color: #fff; font-size: 13px; font-weight: 600;
          }
          .ai-badge img { width: 26px; height: 26px; object-fit: contain; }

          /* --- Birthdays  3D Cube Layout --- */
          .premium-layout {
            display: flex; max-width: 1400px; margin: 60px auto; gap: 30px; padding: 0 20px;
          }
          .birthday-panel {
            flex: 30%; background: #fff; border-radius: 20px; padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center; height: 480px; overflow: hidden;
          }
          .cube-panel {
            flex: 70%; display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #eef2f6, #dce4ec); border-radius: 20px; overflow: hidden;
            min-height: 480px; padding: 40px 0;
          }
          
          /* FIXED: Cube Visibility */
          .cube-container { width: 300px; height: 300px; perspective: 1200px; margin: auto; position: relative; }
          .cube {
            width: 300px; height: 300px; position: relative; transform-style: preserve-3d;
            transition: transform 1s ease-in-out;
          }
          .cube-face {
            position: absolute; width: 300px; height: 300px; border-radius: 15px; overflow: hidden;
            border: 5px solid #fff; box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            background-color: #1e5aa8; /* Fallback color so it's never invisible */
            background-size: cover !important; /* Force image to cover */
            background-position: center !important;
          }
          .cube-title {
            position: absolute; bottom: 0; left: 0; width: 100%; padding: 10px;
            background: rgba(0,0,0,0.5); color: #fff; font-size: 14px; text-align: center;
          }
          .face-front { transform: translateZ(150px); }
          .face-back { transform: rotateY(180deg) translateZ(150px); }
          .face-right { transform: rotateY(90deg) translateZ(150px); }
          .face-left { transform: rotateY(-90deg) translateZ(150px); }
          .cube-controls { margin-top: 20px; text-align: center; position: absolute; bottom: -60px; left: 50%; transform: translateX(-50%); }
          .cube-controls button {
            background: var(--primary-blue); color: #fff; border: none; width: 45px; height: 45px;
            border-radius: 50%; margin: 0 10px; font-size: 18px; cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2); transition: 0.3s;
          }
          .cube-controls button:hover { background: var(--accent-gold); }

          /* --- Event Gallery --- */
          .event-gallery { background: #fff; padding: 40px 0; overflow: hidden; }
          .gallery-row { display: flex; gap: 20px; width: max-content; margin-bottom: 20px; }
          .gallery-row.slide-right { animation: scrollLeft 40s linear infinite; }
          .gallery-row.slide-left { animation: scrollLeft 40s linear infinite reverse; }
          
          /* FIXED: Image fill container */
          .gallery-item {
            width: 350px; min-width: 350px; height: 220px; flex-shrink: 0; 
            border-radius: 12px; overflow: hidden; position: relative; box-shadow: 0 5px 15px rgba(0,0,0,0.1);
          }
          .gallery-item img { 
            width: 100%; height: 100%; object-fit: cover; display: block; 
          }
          .gallery-item:hover img { transform: scale(1.1); transition: transform 0.5s; }

          /* --- About Section --- */
          .about-section { padding: 60px 0; background: var(--light-bg); }
          .about-text {
            padding: 40px; background: #fff; border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05); height: 100%;
          }
          .about-text p { font-size: 1.1rem; line-height: 1.8; color: #444; margin-bottom: 20px; }
          .about-video {
            border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            height: 100%; min-height: 350px; position: relative;
          }
          .about-video iframe { width: 100%; height: 100%; border: none; }
          .about-video-caption {
            position: absolute; bottom: 15px; left: 15px; padding: 8px 16px;
            background: rgba(15, 44, 92, 0.8); color: #fff; border-radius: 8px; font-size: 14px; font-weight: 600;
          }

          /* --- Facilities --- */
          .facilities-section { background: #fff; padding: 60px 0; }
          .facility-card {
            background: #fff; border-radius: 20px; padding: 30px; text-align: center;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05); transition: transform 0.3s; border: 1px solid #eee; height: 100%;
          }
          .facility-card:hover { transform: translateY(-10px); border-color: var(--accent-gold); }
          .facility-icon {
            width: 80px; height: 80px; margin: 0 auto 20px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #fff;
          }
          .icon-blue { background: linear-gradient(135deg, #4aa6ff, #1e5aa8); }
          .icon-gold { background: linear-gradient(135deg, #f0d267, #d4af37); }
          .icon-green { background: linear-gradient(135deg, #41e39b, #1fcf7a); }
          .icon-purple { background: linear-gradient(135deg, #b388ff, #7c4dff); }
          .facility-card h3 { color: var(--primary-blue); font-size: 1.4rem; margin-bottom: 15px; }
          .facility-card p { font-size: 0.95rem; color: #666; line-height: 1.6; }

          /* --- Leadership Team --- */
          .team-section { background: var(--light-bg); padding: 60px 0; }
          .team-card {
            background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            transition: 0.3s; height: 100%;
          }
          .team-card:hover { transform: translateY(-5px); }
          .team-img { width: 100%; height: 300px; object-fit: cover; }
          .team-info { padding: 20px; text-align: center; }
          .team-info h4 { color: var(--primary-blue); margin-bottom: 5px; }
          .team-info p { color: var(--accent-gold); font-weight: 600; margin: 0; }

          /* --- Responsive Fixes --- */
          @media (max-width: 992px) {
            .video-split, .premium-layout, .about-row { flex-direction: column; }
            .video-left iframe { min-height: 300px; }
            .hero-title { font-size: 2.2rem; }
            .birthday-panel { height: auto; margin-bottom: 30px; }
            .cube-panel { min-height: 400px; }
            .about-video { min-height: 250px; }
          }
          @media (max-width: 768px) {
            .hero-title { font-size: 1.8rem; }
            .event-header { font-size: 20px; padding: 10px 20px; }
            .gallery-item { width: 250px; min-width: 250px; height: 150px; }
            .cube-container { width: 220px; height: 220px; perspective: 900px; }
            .cube { width: 220px; height: 220px; }
            .cube-face { width: 220px; height: 220px; }
            .face-front { transform: translateZ(110px); }
            .face-back { transform: rotateY(180deg) translateZ(110px); }
            .face-right { transform: rotateY(90deg) translateZ(110px); }
            .face-left { transform: rotateY(-90deg) translateZ(110px); }
          }
        </style>

        <!-- ============================================== -->
        <!-- HTML STRUCTURE -->
        <!-- ============================================== -->

        <!-- 1. RUNNING BANNER -->
        <t t-if="banner">
          <div class="top-banner">
            <div class="marquee-track">
              <t t-out="banner.info"/>
            </div>
          </div>
        </t>

        <!-- 2. VIDEO & ANNOUNCEMENTS -->
        <section class="video-split">
          <div class="video-left">
            <t t-set="school_vid_url" t-value="school_video_url or ''"/>
            <iframe t-att-src="'https://www.youtube-nocookie.com/embed/' + school_vid_url + '?autoplay=1&amp;mute=1&amp;loop=1&amp;playlist=' + school_vid_url + '&amp;controls=0&amp;modestbranding=1&amp;rel=0&amp;showinfo=0&amp;iv_load_policy=3'"
                    allow="autoplay; encrypted-media"></iframe>
            <div class="video-overlay">
              <h3>🎓 St. Anne's School</h3>
              <p>Where Knowledge Meets Values</p>
            </div>
          </div>
          <div class="announcements-right">
            <div class="glass-card">
              <h4 class="section-title">📢 Announcements</h4>
              <div class="scroll-pane">
                <div class="scroll-content">
                  <t t-raw="notices"/>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 3. HERO TITLE -->
        <section class="hero-section">
          <h1 class="hero-title">
            Change the World with <span class="gradient-text">Education</span> and Carve Your Child's Future with <span class="gradient-text">St. Anne's</span>.
          </h1>
          <p class="hero-subtitle">To Sail in the Ocean of Wisdom...</p>
          <div class="ai-badge">
            <img src="/ala_website/static/src/img/ai_bot.png" alt="AI"/>
            <span>Powered by AI Analysis</span>
          </div>
        </section>

        <!-- 4. BIRTHDAYS & CUBE SLIDER -->
        <section class="premium-layout">
          <!-- Birthdays -->
          <div class="birthday-panel">
            <h4 class="section-title" style="color: var(--primary-blue);">🎂 Birthdays</h4>
            <p style="font-style: italic; color: #666;">Today: <t t-out="today_date"/></p>
            <t t-if="not today_births">
              <b style="color: var(--text-dark);">No birthdays today 🎉</b>
            </t>
            <t t-else="">
              <div class="scroll-pane" style="height: 320px; margin-top: 15px;">
                <div class="scroll-content">
                  <t t-raw="birth_raw_html"/>
                  <div style="text-align:center; margin-top:10px; color: var(--secondary-blue); font-weight:bold;">
                    🎉 Wishing you a wonderful year ahead! 🎂
                  </div>
                </div>
              </div>
            </t>
          </div>

          <!-- 3D Cube -->
          <div class="cube-panel">
            <div class="cube-container">
              <div class="cube" id="multiCube">
                <div class="cube-face face-front"></div>
                <div class="cube-face face-back"></div>
                <div class="cube-face face-right"></div>
                <div class="cube-face face-left"></div>
              </div>
              <div class="cube-controls">
                <button class="cube-prev"><i class="fa fa-chevron-left"></i></button>
                <button class="cube-next"><i class="fa fa-chevron-right"></i></button>
              </div>
            </div>
          </div>
        </section>

        <!-- 5. EVENT PHOTO SLIDER -->
        <section class="event-gallery">
          <div class="event-header-wrapper">
            <h2 class="event-header">
              <span class="event-icon">🎉</span>
              <span>SCHOOL EVENT MEMORIES</span>
            </h2>
          </div>
          <t t-set="photos" t-value="request.env['ala.program.gallery.aws.url'].sudo().search([('program_id.show_website', '=', True)])"/>
          
          <div class="gallery-row slide-right">
            <t t-foreach="photos" t-as="photo">
              <div class="gallery-item"><img t-att-src="photo.url" loading="lazy"/></div>
            </t>
            <t t-foreach="photos" t-as="photo">
              <div class="gallery-item"><img t-att-src="photo.url" loading="lazy"/></div>
            </t>
          </div>

          <div class="gallery-row slide-left">
            <t t-set="rev_photos" t-value="photos[::-1]"/>
            <t t-foreach="rev_photos" t-as="photo">
              <div class="gallery-item"><img t-att-src="photo.url" loading="lazy"/></div>
            </t>
            <t t-foreach="rev_photos" t-as="photo">
              <div class="gallery-item"><img t-att-src="photo.url" loading="lazy"/></div>
            </t>
          </div>
        </section>

        <!-- 6. ABOUT SECTION -->
        <section class="about-section">
          <div class="container">
            <div class="event-header-wrapper">
              <h2 class="event-header"><span>Our School</span></h2>
            </div>
            <div class="row about-row align-items-stretch">
              <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="about-text">
                  <p>We are delighted to welcome you to St. Anne's Convent School, Chotojagulia. Established in 2018, our school is proudly owned by the Society of Sisters of St. Anne, Chennai, a body registered under the Society Registration Act of 1860.</p>
                  <p>As a Catholic educational institution conducted by the Sisters of St. Anne, Chotojagulia, we are a branch of the Society of Sisters of St. Anne. This esteemed Society is dedicated to educational service throughout India, working through numerous institutions to provide quality education and foster holistic development.</p>
                  <p>We look forward to a year filled with learning, growth, and achievement. Together, we aim to uphold the values and vision of our founding Society, ensuring that every student thrives in a nurturing and academically rigorous environment.</p>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="about-video">
                  <t t-set="media_url" t-value="media_url or ''"/>
                  <iframe t-att-src="'https://www.youtube.com/embed/' + media_url + '?autoplay=1&amp;mute=1&amp;controls=0&amp;loop=1&amp;playlist=' + media_url"></iframe>
                  <div class="about-video-caption">🎓 St. Anne's School — Values &amp; Excellence</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 7. FACILITIES -->
        <section class="facilities-section">
          <div class="container text-center">
            <div class="event-header-wrapper">
              <h2 class="event-header">
                <span class="event-icon"><i class="fa-solid fa-school"></i></span>
                <span>School Facilities</span>
              </h2>
            </div>
            <div class="heading-line"></div>
            <div class="row justify-content-center g-4 mt-2">
              <div class="col-lg-3 col-md-6">
                <div class="facility-card">
                  <div class="facility-icon icon-blue"><i class="fa-solid fa-futbol"></i></div>
                  <h3>Play Ground</h3>
                  <p>A spacious play area encouraging physical activity, teamwork, and fun-filled outdoor learning.</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="facility-card">
                  <div class="facility-icon icon-gold"><i class="fa-solid fa-chalkboard-user"></i></div>
                  <h3>Digital Board</h3>
                  <p>Smart classrooms equipped with digital boards for an engaging and interactive learning experience.</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="facility-card">
                  <div class="facility-icon icon-green"><i class="fa-solid fa-computer"></i></div>
                  <h3>Computer Lab</h3>
                  <p>Modern computer lab fostering digital literacy and practical learning for every student.</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="facility-card">
                  <div class="facility-icon icon-purple"><i class="fa-solid fa-flask"></i></div>
                  <h3>Science Lab</h3>
                  <p>Well-equipped lab promoting scientific curiosity and hands-on experimentation safely.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 8. LEADERSHIP TEAM -->
        <t t-if="member_id">
          <section class="team-section">
            <div class="container">
              <div class="event-header-wrapper">
                <h2 class="event-header">
                  <span class="event-icon"><i class="fa-solid fa-users"></i></span>
                  <span>Our Leadership Team</span>
                </h2>
              </div>
              <div class="row justify-content-center g-4">
                <t t-foreach="member_id" t-as="member">
                  <div class="col-lg-3 col-md-6">
                    <div class="team-card">
<!--                      <img t-att-src="member.image_url" class="team-img" alt="Team Member"/>-->
                      <div class="team-info">
                        <h4><t t-out="member.name"/></h4>
<!--                        <p><t t-out="member.role"/></p>-->
                      </div>
                    </div>
                  </div>
                </t>
              </div>
            </div>
          </section>
        </t>

        <!-- ============================================== -->
        <!-- JAVASCRIPT FOR CUBE LOGIC -->
        <!-- ============================================== -->
        <script type="text/javascript">
          <![CDATA[
          document.addEventListener("DOMContentLoaded", function () {
            const jsonHolder = document.getElementById("cube_json_data");
            const cube = document.getElementById("multiCube");
            
            if (!cube) return;

            // If no JSON data, apply default placeholder images so the cube isn't blank
            if (!jsonHolder) {
              const faces = cube.querySelectorAll(".cube-face");
              const placeholders = [
                "https://images.unsplash.com/photo-1577896851231-70ef18881754?auto=format&fit=crop&w=600&q=80",
                "https://images.unsplash.com/photo-1580582932707-520aed9378df?auto=format&fit=crop&w=600&q=80",
                "https://images.unsplash.com/photo-1564422177187-2e0680ba7d36?auto=format&fit=crop&w=600&q=80",
                "https://images.unsplash.com/photo-1571260882299-b5040a9c7d0c?auto=format&fit=crop&w=600&q=80"
              ];
              faces.forEach((face, i) => {
                face.style.backgroundImage = "url('" + placeholders[i] + "')";
                face.innerHTML = "<div class='cube-title'>School Event</div>";
              });
              return;
            }

            let images = JSON.parse(jsonHolder.dataset.json || "[]");
            if (!images.length) return;

            const faces = cube.querySelectorAll(".cube-face");
            let index = 0;
            let rotation = 0;

            function updateFaces() {
              let shuffled = [...images].sort(() => Math.random() - 0.5);
              faces.forEach((face, i) => {
                const data = shuffled[i % shuffled.length];
                face.style.backgroundImage = "url('" + data.url + "')";
                face.innerHTML = "<div class='cube-title'>" + (data.event_name || "") + "</div>";
              });
            }

            updateFaces();

            function rotateCube(dir) {
              rotation -= dir * 90;
              cube.style.transform = "rotateY(" + rotation + "deg)";
              index = (index + dir + images.length) % images.length;
              setTimeout(updateFaces, 500);
            }

            const nextBtn = document.querySelector(".cube-next");
            const prevBtn = document.querySelector(".cube-prev");
            
            if(nextBtn) nextBtn.onclick = () => rotateCube(1);
            if(prevBtn) prevBtn.onclick = () => rotateCube(-1);

            let auto = setInterval(() => rotateCube(1), 5000);
            cube.onmouseenter = () => clearInterval(auto);
            cube.onmouseleave = () => auto = setInterval(() => rotateCube(1), 5000);
          });
          ]]>
        </script>

      </div>
    </t>
  </template>
</odoo>
