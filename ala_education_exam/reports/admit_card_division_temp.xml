    <template id="admit_card_division_report_document">
    <style>
        .a4-sheet {
            position: relative;
        }

        /* Watermark */
        .watermark {
            position: absolute;
            top: 40%;
            left: 35%;
            transform: translate(-50%, -50%);
            opacity: 0.08;
            z-index: 0;
        }
        .watermark img {
            width: 240px;
            height: 210px;
            mix-blend-mode: multiply;
        }

        .admit-card {
            border: 1px solid #000;
            margin-bottom: 20px;
            padding: 16px;
            width: 100%;
            box-sizing: border-box;
            page-break-inside: avoid;
            position: relative;
            z-index: 2;
        }

        .school-header {
            width: 100%;
            border-collapse: collapse;
        }
        .school-header td {
            border: none;
            vertical-align: middle;
        }

        .sub-header {
            text-align: center;
            text-decoration: underline;
            font-family: "Times New Roman", Times, serif;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }
        .info-table td {
            padding: 2px 8px;
            vertical-align: top;
            border: none;
        }

        .exam-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }
        .exam-table, .exam-table th, .exam-table td {
            border: 1px solid #000;
        }
        .exam-table th, .exam-table td {
            padding: 4px 6px;
            font-size: 13px;
            vertical-align: middle;
        }
        .exam-table th {
            background-color: #f1f1f1;
            text-align: center;
        }
        .col-subject { text-align: left !important; }
        .col-center  { text-align: center !important; }

        .sign-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .sign-table td {
            border: none;
            text-align: center;
            font-size: 12px;
            width: 50%;
        }

        .student-photo {
            width: 70px;
            height: 75px;
            border: 1px solid #ccc;
            object-fit: cover;
        }
    </style>

    <t t-set="members" t-value="doc.get_members()"/>
    <t t-set="control_exam" t-value="members.member_line_ids.filtered(lambda x: x.designation == 'contol_exam')"/>
    <t t-set="principal" t-value="members.member_line_ids.filtered(lambda x: x.designation == 'principal')"/>

    <t t-foreach="sorted(class_div.student_ids,
                         key=lambda s: int(str(s.roll_no).strip()) if str(s.roll_no).strip().isdigit() else 999999)"
       t-as="student">

        <div class="a4-sheet">
            <div class="admit-card">

                <!-- ===== SCHOOL HEADER (page-centered) ===== -->
                <table class="school-header">
                    <tr>
                        <td width="15%" style="text-align:left;">
                            <img t-if="student.class_division_id.company_id.logo"
                                 t-att-src="image_data_uri(student.class_division_id.company_id.logo)"
                                 style="height:70px; width:75px; padding:5px;"
                                 alt="Logo"/>
                        </td>
                        <td width="70%" style="text-align:center;">
                            <span style="font-size:24px; font-style:italic; font-weight:bold;">
                                ST.ANNE'S SCHOOL
                            </span>
                            <br/>
                            <span style="font-size:13px; font-weight:bold;">
                                Vill+P.O - Chotojagulia, P.S - Duttapukur, North 24 Parganas - 743294
                            </span>
                        </td>
                        <td width="15%"></td>
                    </tr>
                </table>

                <!-- ===== TITLE BLOCK (page-centered) ===== -->
                <t t-set="first_line" t-value="doc.subject_line_ids.filtered(lambda l: l.date).sorted(key=lambda l: l.date)[:1]"/>

                <div class="sub-header" style="margin:8px 0 4px 0;">
                    <span style="font-size:18px;"><b>ADMIT CARD</b></span>
                </div>

                <div class="sub-header" style="margin-bottom:12px;">
                    <span style="font-size:17px;">
                        <b>SESSION <t t-esc="doc.academic_year_id.name"/>
                            <t t-esc="doc.exam_type_id.name"/>
                            <t t-if="first_line">
                                , <t t-esc="first_line.date.strftime('%B')"/> -
                                <t t-esc="first_line.date.strftime('%Y')"/>
                            </t>
                        </b>
                    </span>
                </div>

                <!-- ===== STUDENT INFO ===== -->
                <table class="info-table">
                    <tr>
                        <td width="18%"></td>
                        <td width="2%"></td>
                        <td width="20%"></td>
                        <td width="18%"></td>
                        <td width="2%"></td>
                        <td width="20%"></td>
                        <td width="20%" rowspan="3">
                            <!--<img t-if="student.image_128"
                                 t-att-src="image_data_uri(student.image_128)"
                                 alt="Student Photo" class="student-photo"/>-->
                        </td>
                    </tr>
                    <tr>
                        <td><b>Student Name</b></td>
                        <td><b>:</b></td>
                        <td><t t-esc="student.name"/></td>
                        <td><b>Register No.</b></td>
                        <td><b>:</b></td>
                        <td><t t-esc="student.register_no"/></td>
                    </tr>
                    <tr>
                        <td><b>Division</b></td>
                        <td><b>:</b></td>
                        <td><t t-esc="student.class_division_id.name"/></td>
                        <td><b>Roll No.</b></td>
                        <td><b>:</b></td>
                        <td><t t-esc="student.roll_no"/></td>
                    </tr>
                </table>

                <!-- ===== EXAM SCHEDULE ===== -->
                <table class="exam-table">
                    <thead>
                        <tr>
                            <th width="23%">Subject</th>
                            <th width="15%">Date</th>
                            <th width="18%">Time</th>
                            <th width="22%">Student's Signature</th>
                            <th width="22%">Invigilator's Signature</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.subject_line_ids.filtered(lambda l: l.date).sorted(key=lambda l: l.date)"
                           t-as="line">
                            <tr>
                                <td class="col-subject">
                                    <span t-field="line.subject_id.name"/>
                                </td>
                                <td class="col-center">
                                    <span t-esc="line.date.strftime('%d-%m-%Y')"/>
                                </td>
                                <td class="col-center">
                                    <span t-field="line.time_from"/> - <span t-field="line.time_to"/>
                                </td>
                                <td class="col-center"></td>
                                <td class="col-center"></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- ===== SIGNATURES ===== -->
                <table class="sign-table">
                    <tr>
                        <td>
                            <t t-if="control_exam.signature">
                                <img t-att-src="'data:image/png;base64,%s' % (control_exam.signature.decode())"
                                     style="max-height:50px; max-width:250px;"/>
                            </t>
                            <br/>
                            <b><t t-esc="control_exam.name"/></b>
                            <br/>Controller of Examiner
                        </td>
                        <td>
                            <t t-if="principal.signature">
                                <img t-att-src="'data:image/png;base64,%s' % (principal.signature.decode())"
                                     style="max-height:50px; max-width:250px;"/>
                            </t>
                            <br/>
                            <b><t t-esc="principal.name"/></b>
                            <br/>Principal
                        </td>
                    </tr>
                </table>

            </div>
        </div>
    </t>
</template>



    <template id="admit_card_division">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
<!--                <t t-call="ala_education_exam.report_print_admit_card_document" t-lang="doc.partner_id.lang"/>-->
                <t t-call="ala_education_exam.admit_card_division_report_document" />
            </t>
        </t>
    </template>

</odoo>
