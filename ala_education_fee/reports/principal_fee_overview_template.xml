<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_principal_fee_overview" model="ir.actions.report">
        <field name="name">Principal Fee Overview</field>
        <field name="model">student.fee.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mis_education_fee.report_principal_fee_overview</field>
        <field name="report_file">mis_education_fee.report_principal_fee_overview</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">'Fee Overview'</field>
    </record>

    <template id="report_principal_fee_overview">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2 class="text-center mb-1">Fee Collection Overview</h2>
                    <p class="text-center text-muted" t-if="date_from or date_to">
                        Period:
                        <span t-esc="date_from or '...'"/> &#8594;
                        <span t-esc="date_to or '...'"/>
                    </p>

                    <table class="table table-sm table-bordered mt-3">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student</th>
                                <th>Register No</th>
                                <th>Division</th>
                                <th>Roll No</th>
                                <th>Mode</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="line">
                                <tr>
                                    <td t-esc="line_index + 1"/>
                                    <td t-esc="line['student']"/>
                                    <td t-esc="line['register_number']"/>
                                    <td t-esc="line['division']"/>
                                    <td t-esc="line['roll_no']"/>
                                    <td t-esc="line['payment_mode']"/>
                                    <td class="text-end">
                                        <span t-esc="line['amount']"
                                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="font-weight:bold;background:#f2f2f2;">
                                <td colspan="6" class="text-end">
                                    Total (<span t-esc="totals['count']"/> collections)
                                </td>
                                <td class="text-end">
                                    <span t-esc="totals['amount']"
                                          t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>