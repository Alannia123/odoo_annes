            <t t-call="ala_student_portal.ala_portal_app_styles"/>

            <div class="o_portal_my_home ala-app">
                <div class="oe_structure" id="oe_structure_portal_my_home_1"/>

                <div class="ala-hero">
                    <div class="ala-hero__row">
                        <img class="ala-hero__avatar"
                             t-att-src="image_data_uri(user_id.partner_id.avatar_128)"
                             t-att-alt="user_id.partner_id.name"/>
                        <div class="ala-hero__meta">
                            <p class="ala-hero__eyebrow">Faculty</p>
                            <h1 class="ala-hero__name"><t t-esc="user_id.partner_id.name"/></h1>
                            <p class="ala-hero__sub">St. Anne's Convent School</p>
                        </div>
                    </div>
                </div>

                <!--
                <div class="ala-section">
                    <span class="ala-section__label">Classroom</span>
                    <span class="ala-section__rule"/>
                </div>
                <div class="ala-grid">
                    <a href="/faculty/attendance" class="ala-tile">
                        <span class="ala-tile__plate ala-t-att"><i class="fa fa-calendar-check-o"/></span>
                        <span class="ala-tile__label">Mark Attendance</span>
                    </a>
                </div>
                -->

                <div class="ala-section">
                    <span class="ala-section__label">Account</span>
                    <span class="ala-section__rule"/>
                </div>

                <a href="/my/security" class="ala-card">
                    <span class="ala-card__icon"><i class="fa fa-lock"/></span>
                    <span>
                        <p class="ala-card__title">Password &amp; security</p>
                        <p class="ala-card__text">Change your password or sign out everywhere</p>
                    </span>
                    <i class="fa fa-angle-right ala-card__go"/>
                </a>

                <div class="oe_structure" id="oe_structure_portal_my_home_2"/>
            </div>
        </t>
    </template>

</odoo>