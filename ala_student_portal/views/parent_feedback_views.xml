<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ala_parent_feedback_list" model="ir.ui.view">
        <field name="name">ala.parent.feedback.list</field>
        <field name="model">ala.parent.feedback</field>
        <field name="arch" type="xml">
            <list string="Parent Feedback"
                  decoration-danger="state == 'new' and priority == '2'"
                  decoration-info="state == 'new'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="create_date" string="Received"/>
                <field name="student_id"/>
                <field name="class_division_id"/>
                <field name="category"/>
                <field name="subject"/>
                <field name="rating" optional="show"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'resolved'"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ala_parent_feedback_form" model="ir.ui.view">
        <field name="name">ala.parent.feedback.form</field>
        <field name="model">ala.parent.feedback</field>
        <field name="arch" type="xml">
            <form string="Parent Feedback">
                <header>
                    <button name="action_start" type="object" string="Start Review"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_resolve" type="object" string="Mark Resolved"
                            class="btn-primary"
                            invisible="state not in ('new', 'in_progress')"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state == 'closed'"/>
                    <button name="action_reset" type="object" string="Reopen"
                            invisible="state not in ('resolved', 'closed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" readonly="1"/>
                            <field name="class_division_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="create_date" string="Received" readonly="1"/>
                        </group>
                        <group>
                            <field name="category" readonly="1"/>
                            <field name="rating" readonly="1"/>
                            <field name="priority" widget="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Feedback">
                        <field name="subject" readonly="1" nolabel="1" colspan="2"/>
                        <field name="description" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <group string="School Response">
                        <field name="response" nolabel="1" colspan="2"
                               placeholder="This text is shown to the parent in the portal."/>
                        <field name="responded_by_id" readonly="1"/>
                        <field name="response_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ala_parent_feedback_search" model="ir.ui.view">
        <field name="name">ala.parent.feedback.search</field>
        <field name="model">ala.parent.feedback</field>
        <field name="arch" type="xml">
            <search string="Parent Feedback">
                <field name="name"/>
                <field name="subject"/>
                <field name="student_id"/>
                <field name="class_division_id"/>
                <filter name="f_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="f_open" string="Open"
                        domain="[('state', 'in', ('new', 'in_progress'))]"/>
                <filter name="f_urgent" string="Urgent" domain="[('priority', '=', '2')]"/>
                <separator/>
                <filter name="f_month" string="This Month"
                        domain="[('create_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="g_class" string="Class" context="{'group_by': 'class_division_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ala_parent_feedback" model="ir.actions.act_window">
        <field name="name">Parent Feedback</field>
        <field name="res_model">ala.parent.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No feedback yet</p>
            <p>Feedback submitted by parents from the student portal appears here.</p>
        </field>
    </record>

    <menuitem id="menu_ala_parent_feedback"
              name="Parent Feedback"
              action="action_ala_parent_feedback"
              sequence="90"/>

</odoo>