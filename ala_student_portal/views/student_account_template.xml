<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====
         Shared app styles. t-call from any portal page.
         ==== -->
    <template id="ala_portal_app_styles" name="ALA Portal App Styles">
        <style>
            .ala-app{
                -webkit-tap-highlight-color: transparent;
                font-family: -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif;
                color: #0f172a;
                padding-bottom: calc(78px + env(safe-area-inset-bottom, 0px));
            }
            .ala-app a{ text-decoration: none; }

            /* ---------- Greeting band ---------- */
            .ala-greet{
                position: relative;
                margin: -12px -12px 0;
                padding: 18px 18px 56px;
                background: linear-gradient(140deg, #14306b 0%, #1e4fa3 60%, #2c6fd1 100%);
                border-radius: 0 0 28px 28px;
                color: #fff;
                overflow: hidden;
            }
            .ala-greet:before{
                content: "";
                position: absolute;
                top: -70%; left: -15%;
                width: 65%; height: 200%;
                background: linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,0) 62%);
                transform: rotate(20deg);
                pointer-events: none;
            }
            .ala-greet__row{
                position: relative;
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .ala-greet__meta{ flex: 1 1 auto; min-width: 0; }
            .ala-greet__hello{
                margin: 0;
                font-size: 12.5px;
                color: #f2c14e;
                font-weight: 600;
                letter-spacing: .04em;
            }
            .ala-greet__name{
                margin: 2px 0 0;
                font-size: 21px;
                font-weight: 700;
                line-height: 1.15;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .ala-greet__avatar{
                flex: 0 0 auto;
                width: 54px; height: 54px;
                border-radius: 50%;
                object-fit: cover;
                border: 3px solid rgba(255,255,255,.7);
                box-shadow: 0 4px 12px rgba(0,0,0,.28);
                background: rgba(255,255,255,.18);
            }
            .ala-greet__chips{
                position: relative;
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                margin-top: 12px;
            }
            .ala-chip{
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 4px 11px;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 600;
                background: rgba(255,255,255,.16);
                border: 1px solid rgba(255,255,255,.24);
                color: #fff;
            }
            .ala-chip--ok{ background: rgba(22,163,74,.95); }
            .ala-chip--warn{ background: rgba(245,158,11,.96); color: #1f2937; }
            .ala-chip--danger{ background: rgba(220,38,38,.95); }
            .ala-chip--link{ color: #fff; text-decoration: none; }
            .ala-chip--link:hover, .ala-chip--link:focus{ color: #fff; text-decoration: none; }

            /* ---------- Card that lifts over the band ---------- */
            .ala-sheet{
                position: relative;
                margin: -42px 0 0;
                padding: 16px 14px 18px;
                background: #fff;
                border-radius: 22px;
                box-shadow: 0 10px 28px rgba(15,23,42,.12);
            }
            .ala-sheet__school{
                margin: 0 0 14px;
                text-align: center;
                font-size: 15px;
                font-weight: 700;
                color: #14306b;
                line-height: 1.3;
            }

            /* ---------- Ticker ---------- */
            .ala-ticker{
                display: flex;
                align-items: center;
                gap: 9px;
                margin-top: 12px;
                padding: 8px 12px;
                border-radius: 14px;
                background: #fff8e6;
                border: 1px solid #f3dfa8;
                color: #7c4a03;
                font-size: 12.5px;
                font-weight: 600;
                overflow: hidden;
            }
            .ala-ticker i{ flex: 0 0 auto; color: #b45309; }
            .ala-ticker__view{ flex: 1 1 auto; overflow: hidden; }
            .ala-ticker__track{
                display: inline-block;
                white-space: nowrap;
                padding-left: 100%;
                animation: ala-slide 16s linear infinite;
            }
            @keyframes ala-slide{
                0%{ transform: translateX(0); }
                100%{ transform: translateX(-100%); }
            }

            /* ---------- Section header ---------- */
            .ala-head{
                display: flex;
                align-items: baseline;
                gap: 10px;
                margin: 22px 4px 11px;
            }
            .ala-head__title{
                margin: 0;
                font-size: 15px;
                font-weight: 700;
                color: #0f172a;
            }
            .ala-head__more{
                margin-left: auto;
                font-size: 12px;
                font-weight: 600;
                color: #1e4fa3;
            }

            /* ---------- Quick action tiles ---------- */
            .ala-grid{
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 12px 8px;
            }
            @media (max-width: 340px){
                .ala-grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
            }
            @media (min-width: 768px){
                .ala-grid{ grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px 12px; }
            }
            .ala-tile{
                position: relative;
                display: block;
                text-align: center;
            }
            .ala-tile__plate{
                display: block;
                position: relative;
                width: 100%;
                padding-top: 100%;
                border-radius: 18px;
                background: #fff;
                border: 1px solid #e8edf4;
                box-shadow: 0 4px 10px rgba(15,23,42,.07);
                overflow: hidden;
                transition: transform .16s ease, box-shadow .16s ease;
            }
            .ala-tile__plate i{
                position: absolute;
                top: 50%; left: 50%;
                transform: translate(-50%, -50%);
                font-size: 25px;
            }
            .ala-tile:active .ala-tile__plate{
                transform: scale(.93);
                box-shadow: 0 2px 5px rgba(15,23,42,.10);
            }
            .ala-tile__label{
                display: block;
                margin-top: 7px;
                font-size: 11px;
                line-height: 1.25;
                font-weight: 600;
                color: #334155;
                min-height: 2.5em;
            }
            @media (min-width: 768px){
                .ala-tile__plate i{ font-size: 32px; }
                .ala-tile__label{ font-size: 12.5px; }
            }

            /* soft tinted plates, one hue per destination */
            .ala-p-fee   { background: #ecfdf5; } .ala-p-fee i   { color: #059669; }
            .ala-p-news  { background: #fdf4ff; } .ala-p-news i  { color: #a21caf; }
            .ala-p-work  { background: #f5f3ff; } .ala-p-work i  { color: #7c3aed; }
            .ala-p-time  { background: #ecfeff; } .ala-p-time i  { color: #0891b2; }
            .ala-p-att   { background: #fdf2f8; } .ala-p-att i   { color: #db2777; }
            .ala-p-class { background: #eff6ff; } .ala-p-class i { color: #1d4ed8; }
            .ala-p-tchr  { background: #f0fdfa; } .ala-p-tchr i  { color: #0d9488; }
            .ala-p-exam  { background: #fff7ed; } .ala-p-exam i  { color: #ea580c; }
            .ala-p-info  { background: #f8fafc; } .ala-p-info i  { color: #475569; }
            .ala-p-off   { background: #f1f5f9; } .ala-p-off i   { color: #94a3b8; }
            .ala-p-fb    { background: #fff1f2; } .ala-p-fb i    { color: #be123c; }

            .ala-badge{
                position: absolute;
                top: -5px; right: -3px;
                z-index: 2;
                min-width: 20px; height: 20px;
                padding: 0 6px;
                border-radius: 999px;
                background: #dc2626;
                color: #fff;
                font-size: 10.5px;
                font-weight: 700;
                line-height: 20px;
                text-align: center;
                border: 2px solid #fff;
                box-shadow: 0 2px 5px rgba(0,0,0,.18);
            }
            .ala-badge--ok{ background: #16a34a; }
            .ala-badge--warn{ background: #f59e0b; color: #1f2937; }

            /* ---------- Generic card ---------- */
            .ala-card{
                padding: 15px 14px;
                border-radius: 18px;
                background: #fff;
                border: 1px solid #e8edf4;
                box-shadow: 0 4px 12px rgba(15,23,42,.06);
            }

            /* ---------- Attendance ---------- */
            .ala-att__stats{
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 8px;
                margin-bottom: 14px;
            }
            .ala-stat{ text-align: center; }
            .ala-stat__dot{
                width: 46px; height: 46px;
                margin: 0 auto 5px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                font-weight: 700;
                color: #fff;
                box-shadow: 0 4px 9px rgba(15,23,42,.16);
            }
            .ala-stat__label{ font-size: 10.5px; font-weight: 600; color: #64748b; }
            .ala-stat--p .ala-stat__dot{ background: linear-gradient(150deg,#22c55e,#15803d); }
            .ala-stat--a .ala-stat__dot{ background: linear-gradient(150deg,#ef4444,#991b1b); }
            .ala-stat--h .ala-stat__dot{ background: linear-gradient(150deg,#38bdf8,#0369a1); }
            .ala-stat--w .ala-stat__dot{ background: linear-gradient(150deg,#fb923c,#c2410c); }

            .ala-cal{
                display: grid;
                grid-template-columns: repeat(7, minmax(0, 1fr));
                gap: 4px;
            }
            .ala-cal__dow{
                text-align: center;
                font-size: 10.5px;
                font-weight: 700;
                color: #94a3b8;
                padding-bottom: 4px;
            }
            .ala-cal__day{
                aspect-ratio: 1 / 1;
                min-height: 30px;
                border-radius: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11.5px;
                font-weight: 600;
                color: #475569;
            }
            .ala-cal__day--present{ background: #22c55e; color: #fff; }
            .ala-cal__day--absent{ background: #ef4444; color: #fff; }
            .ala-cal__day--holiday{ background: #334155; color: #fff; }
            .ala-cal__day--today{ box-shadow: inset 0 0 0 2px #1e4fa3; }
            .ala-cal__day--empty{ visibility: hidden; }

            .ala-legend{
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 12px;
                font-size: 10.5px;
                color: #64748b;
                font-weight: 600;
            }
            .ala-legend span{ display: inline-flex; align-items: center; gap: 5px; }
            .ala-legend i{
                width: 10px; height: 10px;
                border-radius: 3px;
                display: inline-block;
            }

            /* ---------- Horizontal scroller ---------- */
            .ala-rail{
                display: flex;
                gap: 10px;
                overflow-x: auto;
                padding: 2px 4px 8px;
                margin: 0 -4px;
                -webkit-overflow-scrolling: touch;
                scroll-snap-type: x mandatory;
            }
            .ala-rail::-webkit-scrollbar{ display: none; }
            .ala-hw{
                flex: 0 0 66%;
                max-width: 240px;
                scroll-snap-align: start;
                padding: 13px 14px;
                border-radius: 16px;
                border: 1px solid #e8edf4;
                background: #fffbeb;
            }
            .ala-hw:nth-child(even){ background: #fdf2f8; }
            .ala-hw__subject{
                margin: 0;
                font-size: 13.5px;
                font-weight: 700;
                color: #0f172a;
                line-height: 1.3;
            }
            .ala-hw__date{
                margin: 4px 0 0;
                font-size: 11.5px;
                font-weight: 600;
                color: #b45309;
            }
            .ala-hw__text{
                margin: 7px 0 0;
                font-size: 11.5px;
                color: #64748b;
                line-height: 1.4;
                max-height: 3.2em;
                overflow: hidden;
            }

            /* ---------- Message feed ---------- */
            .ala-msg{
                display: flex;
                gap: 11px;
                padding: 11px 0;
                border-bottom: 1px solid #f1f5f9;
            }
            .ala-msg:last-child{ border-bottom: 0; }
            .ala-msg__date{
                flex: 0 0 auto;
                width: 52px;
                padding: 8px 0;
                border-radius: 12px;
                background: linear-gradient(150deg,#0e7490,#155e75);
                color: #fff;
                text-align: center;
                line-height: 1.15;
            }
            .ala-msg__d{ display: block; font-size: 15px; font-weight: 700; }
            .ala-msg__m{ display: block; font-size: 9.5px; text-transform: uppercase; letter-spacing: .08em; }
            .ala-msg__body{ min-width: 0; flex: 1 1 auto; }
            .ala-msg__kind{
                display: inline-block;
                margin: 0 0 3px;
                padding: 1px 8px;
                border-radius: 999px;
                background: #eff6ff;
                color: #1d4ed8;
                font-size: 10px;
                font-weight: 700;
            }
            .ala-msg__text{
                margin: 0;
                font-size: 12.5px;
                color: #475569;
                line-height: 1.45;
                max-height: 2.9em;
                overflow: hidden;
            }

            /* ---------- Fee donut ---------- */
            .ala-fee{
                display: flex;
                align-items: center;
                gap: 16px;
                flex-wrap: wrap;
            }
            .ala-fee__chart{ position: relative; flex: 0 0 auto; width: 132px; height: 132px; }
            .ala-fee__pct{
                position: absolute;
                top: 50%; left: 50%;
                transform: translate(-50%, -50%);
                text-align: center;
            }
            .ala-fee__pct b{ display: block; font-size: 20px; font-weight: 700; color: #0f172a; }
            .ala-fee__pct span{ display: block; font-size: 10px; color: #94a3b8; font-weight: 600; }
            .ala-fee__list{ flex: 1 1 150px; min-width: 140px; }
            .ala-fee__row{
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 10px;
                border: 1px solid #e8edf4;
                border-radius: 11px;
                margin-bottom: 7px;
            }
            .ala-fee__row:last-child{ margin-bottom: 0; }
            .ala-fee__key{ font-size: 11.5px; font-weight: 600; color: #64748b; }
            .ala-fee__val{ margin-left: auto; font-size: 13px; font-weight: 700; color: #0f172a; }
            .ala-fee__dot{ width: 12px; height: 12px; border-radius: 50%; flex: 0 0 auto; }

            .ala-btn{
                display: block;
                margin-top: 13px;
                padding: 11px 16px;
                border-radius: 13px;
                text-align: center;
                font-size: 13.5px;
                font-weight: 700;
                color: #fff;
                background: linear-gradient(135deg,#16a34a,#15803d);
                box-shadow: 0 5px 14px rgba(21,128,61,.28);
            }
            .ala-btn:active{ transform: scale(.98); }
            .ala-btn, .ala-btn:hover, .ala-btn:focus{ color: #fff; }

            .ala-empty{
                padding: 20px 12px;
                text-align: center;
                font-size: 12.5px;
                color: #94a3b8;
            }

            /* ---------- Bottom tab bar ---------- */
            .ala-tabs{
                position: fixed;
                left: 0; right: 0; bottom: 0;
                z-index: 1040;
                display: grid;
                grid-template-columns: repeat(5, 1fr);
                padding: 7px 4px;
                padding-bottom: calc(7px + env(safe-area-inset-bottom, 0px));
                background: #fff;
                border-top: 1px solid #e8edf4;
                box-shadow: 0 -4px 16px rgba(15,23,42,.08);
            }
            .ala-tabs__item{
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 3px;
                padding: 5px 2px;
                font-size: 10px;
                font-weight: 600;
                color: #94a3b8;
                border-radius: 12px;
            }
            .ala-tabs__item i{ font-size: 17px; }
            .ala-tabs__item--on{ color: #1e4fa3; background: #eff6ff; }
            .ala-tabs__item--on i{ color: #1e4fa3; }

            @media (prefers-reduced-motion: reduce){
                .ala-ticker__track{ animation: none; }
                .ala-tile__plate, .ala-btn{ transition: none; }
            }
        </style>
    </template>

    <template id="portal.portal_layout" name="Portal Layout">
    <t t-call="portal.frontend_layout">
        <t t-set="is_portal" t-value="True"/>

        <div t-if="not no_breadcrumbs and not my_details and not breadcrumbs_searchbar"
             class="o_portal container mt-3">
            <div class="d-flex justify-content-between align-items-center">
                <t t-call="portal.portal_breadcrumbs"/>
                <t t-if="prev_record or next_record" t-call="portal.record_pager"/>
            </div>
        </div>

        <style>
            .animated-heading-mob {
                font-size: 1.8em;
                color: #878273;
                animation: fadeInMove 3s ease-in-out, colorChange 3s 3s infinite alternate;
            }
            @keyframes fadeInMove {
                0%   { opacity: 0; transform: translateY(-20px); }
                100% { opacity: 1; transform: translateY(0); }
            }
            @keyframes colorChange {
                0%   { color: #00c2eb; }
                50%  { color: #a66963; }
                100% { color: #b0cc8c; }
            }
            .logout-btn {
                display: flex;
                align-items: center;
                gap: 8px;
                background: #009900;
                color: white;
                padding: 10px 15px;
                border: none;
                border-radius: 15px;
                font-size: 15px;
                cursor: pointer;
            }
            .logout-btn i { font-size: 14px; }
        </style>

        <div id="wrap" class="o_portal_wrap">
            <div class="container pt-3">
                <t t-if="my_details">
                    <div class="o_portal_content col-12">
                        <t t-out="0"/>
                    </div>
                </t>
                <t t-else="">
                    <t t-out="0"/>
                </t>
            </div>
        </div>
    </t>
</template>

    <!-- ====
         STUDENT / PARENT HOME
         ==== -->
    <template id="student_portal_my_home" name="My Student Portal">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="True"/>
            <t t-call="ala_student_portal.ala_portal_app_styles"/>

            <div class="o_portal_my_home ala-app">
                <div class="oe_structure" id="oe_structure_portal_my_home_1"/>

                <!-- Greeting -->
                <div class="ala-greet">
                    <div class="ala-greet__row">
                        <div class="ala-greet__meta">
                            <p class="ala-greet__hello"><t t-esc="greeting"/></p>
                            <h1 class="ala-greet__name">
                                Hi, <t t-esc="student.name if student else user_id.partner_id.name"/>
                            </h1>
                        </div>
                        <img class="ala-greet__avatar"
                             t-att-src="image_data_uri(user_id.partner_id.avatar_128)"
                             t-att-alt="user_id.partner_id.name"/>
                    </div>
                    <div class="ala-greet__chips">
                        <span class="ala-chip" t-if="div_name">
                            <i class="fa fa-users"/> Class <t t-esc="div_name"/>
                        </span>
                        <span t-if="attendance == 'Present'" class="ala-chip ala-chip--ok">
                            <i class="fa fa-check-circle"/> Present today
                        </span>
                        <span t-if="attendance == 'Absent'" class="ala-chip ala-chip--danger">
                            <i class="fa fa-times-circle"/> Absent today
                        </span>
                        <span t-if="fee_status == 'over_due'" class="ala-chip ala-chip--danger">
                            <i class="fa fa-exclamation-circle"/> Fees overdue
                        </span>
                        <span t-if="fee_status == 'unpaid'" class="ala-chip ala-chip--warn">
                            <i class="fa fa-inr"/> Fees due
                        </span>
                        <a href="https://st.annes.school/" target="_blank"
                           rel="noopener" class="ala-chip ala-chip--link">
                            <i class="fa fa-globe"/> School Website
                        </a>
                    </div>
                </div>

                <!-- Quick actions -->
                <div class="ala-sheet">
                    <p class="ala-sheet__school">St. Anne's Convent School</p>

                    <div class="ala-ticker" t-if="today_event">
                        <i class="fa fa-bullhorn"/>
                        <div class="ala-ticker__view">
                            <span class="ala-ticker__track"><t t-esc="today_event.name"/></span>
                        </div>
                    </div>

                    <div class="ala-head" style="margin-top:16px;">
                        <h2 class="ala-head__title">Quick Actions</h2>
                    </div>

                    <div class="ala-grid">
                        <a href="/my/fees" class="ala-tile">
                            <span t-if="fee_status == 'over_due'" class="ala-badge">!</span>
                            <span t-if="fee_status == 'unpaid'" class="ala-badge ala-badge--warn">Due</span>
                            <span class="ala-tile__plate ala-p-fee"><i class="fa fa-inr"/></span>
                            <span class="ala-tile__label">Fees</span>
                        </a>
                        <a href="/school/all_homeworks" class="ala-tile">
                            <span class="ala-badge" t-if="today_home_work_count">
                                <t t-esc="today_home_work_count"/>
                            </span>
                            <span class="ala-tile__plate ala-p-work"><i class="fa fa-book"/></span>
                            <span class="ala-tile__label">Home Work</span>
                        </a>
                        <a href="/school/announcements" class="ala-tile">
                            <span class="ala-badge" t-if="today_announce_count">
                                <t t-esc="today_announce_count"/>
                            </span>
                            <span class="ala-tile__plate ala-p-news"><i class="fa fa-bullhorn"/></span>
                            <span class="ala-tile__label">Notices</span>
                        </a>
                        <a href="/school/timetable" class="ala-tile">
                            <span class="ala-tile__plate ala-p-time"><i class="fa fa-clock-o"/></span>
                            <span class="ala-tile__label">Timetable</span>
                        </a>
                        <a href="/school/student_attendance" class="ala-tile">
                            <span t-if="attendance == 'Present'" class="ala-badge ala-badge--ok">
                                <i class="fa fa-check"/>
                            </span>
                            <span t-if="attendance == 'Absent'" class="ala-badge">
                                <i class="fa fa-times"/>
                            </span>
                            <span class="ala-tile__plate ala-p-att"><i class="fa fa-calendar-check-o"/></span>
                            <span class="ala-tile__label">Attendance</span>
                        </a>
                        <a href="/school/class_communation" class="ala-tile">
                            <span class="ala-badge" t-if="today_cl_comm_count">
                                <t t-esc="today_cl_comm_count"/>
                            </span>
                            <span class="ala-tile__plate ala-p-class"><i class="fa fa-comments"/></span>
                            <span class="ala-tile__label">Class Notes</span>
                        </a>
                        <a href="/school/teacher_communation" class="ala-tile">
                            <span class="ala-badge" t-if="today_stu_comm_count">
                                <t t-esc="today_stu_comm_count"/>
                            </span>
                            <span class="ala-tile__plate ala-p-tchr"><i class="fa fa-comment"/></span>
                            <span class="ala-tile__label">Teacher Notes</span>
                        </a>
                        <a href="/my/result" class="ala-tile">
                            <span class="ala-tile__plate ala-p-exam"><i class="fa fa-graduation-cap"/></span>
                            <span class="ala-tile__label">Results</span>
                        </a>
                        <a href="/my/feedback" class="ala-tile">
                            <span class="ala-tile__plate ala-p-fb"><i class="fa fa-commenting-o"/></span>
                            <span class="ala-tile__label">Feedback</span>
                        </a>
                    </div>
                </div>

                <!-- Attendance -->
                <div class="ala-head">
                    <h2 class="ala-head__title">My Attendance</h2>
                    <a href="/school/student_attendance" class="ala-head__more">View all</a>
                </div>

                <div class="ala-card">
                    <p style="margin:0 0 13px; text-align:center; font-size:13px; font-weight:700; color:#334155;">
                        <t t-esc="att_month_label"/>
                    </p>

                    <div class="ala-att__stats">
                        <div class="ala-stat ala-stat--p">
                            <div class="ala-stat__dot"><t t-esc="att_present"/></div>
                            <div class="ala-stat__label">Present</div>
                        </div>
                        <div class="ala-stat ala-stat--a">
                            <div class="ala-stat__dot"><t t-esc="att_absent"/></div>
                            <div class="ala-stat__label">Absent</div>
                        </div>
                        <div class="ala-stat ala-stat--h">
                            <div class="ala-stat__dot"><t t-esc="att_holiday"/></div>
                            <div class="ala-stat__label">Holiday</div>
                        </div>
                        <div class="ala-stat ala-stat--w">
                            <div class="ala-stat__dot"><t t-esc="att_present + att_absent"/></div>
                            <div class="ala-stat__label">Marked</div>
                        </div>
                    </div>

                    <div class="ala-cal">
                        <div class="ala-cal__dow">S</div>
                        <div class="ala-cal__dow">M</div>
                        <div class="ala-cal__dow">T</div>
                        <div class="ala-cal__dow">W</div>
                        <div class="ala-cal__dow">T</div>
                        <div class="ala-cal__dow">F</div>
                        <div class="ala-cal__dow">S</div>

                        <t t-foreach="att_weeks" t-as="week">
                            <t t-foreach="week" t-as="day">
                                <div t-if="not day" class="ala-cal__day ala-cal__day--empty"/>
                                <t t-else="">
                                    <t t-set="day_status" t-value="att_status_by_day.get(day)"/>
                                    <div t-attf-class="ala-cal__day #{'ala-cal__day--' + day_status if day_status else ''} #{'ala-cal__day--today' if day == att_today_day else ''}">
                                        <t t-esc="day"/>
                                    </div>
                                </t>
                            </t>
                        </t>
                    </div>

                    <div class="ala-legend">
                        <span><i style="background:#22c55e"/> Present</span>
                        <span><i style="background:#ef4444"/> Absent</span>
                        <span><i style="background:#334155"/> Holiday</span>
                    </div>
                </div>

                <!-- Assignments -->
                <div class="ala-head">
                    <h2 class="ala-head__title">Assignments</h2>
                    <a href="/school/all_homeworks" class="ala-head__more">View all</a>
                </div>

                <div t-if="homework_cards" class="ala-rail">
                    <a t-foreach="homework_cards" t-as="hw"
                       t-attf-href="/homework/get_homework/#{hw['id']}" class="ala-hw">
                        <p class="ala-hw__subject"><t t-esc="hw['subject']"/></p>
                        <p class="ala-hw__date">
                            <i class="fa fa-calendar-o"/>
                            <t t-esc="hw['date'].strftime('%d %b %Y') if hw['date'] else ''"/>
                        </p>
                        <p class="ala-hw__text" t-esc="hw['text']"/>
                    </a>
                </div>
                <div t-else="" class="ala-card ala-empty">
                    No homework posted yet.
                </div>

                <!-- Communication -->
                <div class="ala-head">
                    <h2 class="ala-head__title">Communication</h2>
                    <a href="/school/class_communation" class="ala-head__more">View all</a>
                </div>

                <div class="ala-card" t-if="message_feed">
                    <a t-foreach="message_feed" t-as="msg"
                       t-att-href="msg['url']" class="ala-msg">
                        <span class="ala-msg__date">
                            <span class="ala-msg__d"><t t-esc="msg['date'].strftime('%d')"/></span>
                            <span class="ala-msg__m"><t t-esc="msg['date'].strftime('%b')"/></span>
                        </span>
                        <span class="ala-msg__body">
                            <span class="ala-msg__kind"><t t-esc="msg['kind']"/></span>
                            <p class="ala-msg__text" t-esc="msg['desc']"/>
                        </span>
                    </a>
                </div>
                <div t-else="" class="ala-card ala-empty">
                    No messages yet.
                </div>

                <!-- Fee status -->
                <div class="ala-head">
                    <h2 class="ala-head__title">Fee Status</h2>
                    <a href="/my/fees" class="ala-head__more">Details</a>
                </div>

                <div class="ala-card">
                    <div class="ala-fee">
                        <div class="ala-fee__chart">
                            <svg viewBox="0 0 132 132" width="132" height="132" role="img"
                                 aria-label="Fee payment progress">
                                <circle cx="66" cy="66" r="54" fill="none"
                                        stroke="#fecaca" stroke-width="16"/>
                                <circle cx="66" cy="66" r="54" fill="none"
                                        stroke="#22c55e" stroke-width="16"
                                        stroke-linecap="round"
                                        t-att-stroke-dasharray="fee_dash_paid"
                                        transform="rotate(-90 66 66)"/>
                            </svg>
                            <div class="ala-fee__pct">
                                <b><t t-esc="fee_paid_pct"/>%</b>
                                <span>PAID</span>
                            </div>
                        </div>

                        <div class="ala-fee__list">
                            <div class="ala-fee__row">
                                <span class="ala-fee__dot" style="background:#1d4ed8"/>
                                <span class="ala-fee__key">Payable</span>
                                <span class="ala-fee__val">
                                    <t t-esc="'{:,.0f}'.format(fee_total)"/>
                                </span>
                            </div>
                            <div class="ala-fee__row">
                                <span class="ala-fee__dot" style="background:#22c55e"/>
                                <span class="ala-fee__key">Paid</span>
                                <span class="ala-fee__val">
                                    <t t-esc="'{:,.0f}'.format(fee_paid)"/>
                                </span>
                            </div>
                            <div class="ala-fee__row">
                                <span class="ala-fee__dot" style="background:#ef4444"/>
                                <span class="ala-fee__key">Balance</span>
                                <span class="ala-fee__val">
                                    <t t-esc="'{:,.0f}'.format(fee_balance)"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <a href="/my/fees" class="ala-btn" t-if="fee_balance">
                        <i class="fa fa-lock"/> Pay Now
                    </a>
                </div>

                <div class="oe_structure" id="oe_structure_portal_my_home_2"/>
            </div>

            <!-- Bottom tab bar -->
            <div class="ala-tabs">
                <a href="/my/home" class="ala-tabs__item ala-tabs__item--on">
                    <i class="fa fa-home"/><span>Home</span>
                </a>
                <a href="/school/all_homeworks" class="ala-tabs__item">
                    <i class="fa fa-book"/><span>Work</span>
                </a>
                <a href="/school/class_communation" class="ala-tabs__item">
                    <i class="fa fa-paper-plane"/><span>Messages</span>
                </a>
                <a href="/my/feedback" class="ala-tabs__item">
                    <i class="fa fa-commenting-o"/><span>Feedback</span>
                </a>
                <a href="/school/student_info" class="ala-tabs__item">
                    <i class="fa fa-user"/><span>Profile</span>
                </a>
            </div>
        </t>
    </template>

</odoo>