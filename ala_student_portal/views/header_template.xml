<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         MOBILE APP BAR
         Inherits the stock header instead of replacing it, so Odoo
         point-release patches to website.template_header_mobile keep
         applying. Public visitors get the untouched stock navbar;
         logged-in portal users get the app bar.

         IMPORTANT: delete your existing full override of
         website.template_header_mobile before loading this file.
         ============================================================ -->
    <template id="website.template_header_mobile" name="St. Anne's Mobile App Bar">

<!--        &lt;!&ndash; Stock navbar: public visitors only &ndash;&gt;-->
<!--        <xpath expr="//div[@id='o_main_nav']" position="attributes">-->
<!--            <attribute name="t-if">request.env.user._is_public()</attribute>-->
<!--        </xpath>-->

        <!-- App bar: authenticated users -->
        <xpath expr="//div[@id='o_main_nav']" position="before">

            <style>
                .ala-appbar{
                    position: sticky;
                    top: 0;
                    z-index: 1030;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    width: 100%;
                    padding: 8px 12px;
                    padding-top: calc(8px + env(safe-area-inset-top, 0px));
                    background: linear-gradient(135deg, #14306b 0%, #1e4fa3 62%, #2c6fd1 100%);
                    border-bottom: 2px solid #f2c14e;
                    box-shadow: 0 3px 12px rgba(20, 48, 107, .28);
                    -webkit-tap-highlight-color: transparent;
                }
                .ala-appbar:before{
                    content: "";
                    position: absolute;
                    top: 0; left: 0; right: 0;
                    height: 50%;
                    background: linear-gradient(180deg, rgba(255,255,255,.20), rgba(255,255,255,0));
                    pointer-events: none;
                }
                .ala-appbar__crest{
                    position: relative;
                    flex: 0 0 auto;
                    width: 38px; height: 38px;
                    border-radius: 10px;
                    object-fit: contain;
                    background: #fff;
                    padding: 3px;
                    box-shadow: 0 2px 6px rgba(0,0,0,.22);
                }
                .ala-appbar__titles{
                    position: relative;
                    flex: 1 1 auto;
                    min-width: 0;
                    line-height: 1.15;
                }
                .ala-appbar__name{
                    display: block;
                    margin: 0;
                    font-size: 15px;
                    font-weight: 700;
                    color: #fff;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .ala-appbar__tag{
                    display: block;
                    margin: 1px 0 0;
                    font-size: 9.5px;
                    letter-spacing: .16em;
                    text-transform: uppercase;
                    font-weight: 600;
                    color: #f2c14e;
                }
                .ala-appbar__exit{
                    position: relative;
                    flex: 0 0 auto;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    padding: 7px 13px;
                    border-radius: 999px;
                    font-size: 12px;
                    font-weight: 600;
                    color: #fff;
                    text-decoration: none;
                    background: rgba(255,255,255,.16);
                    border: 1px solid rgba(255,255,255,.28);
                    transition: background .18s ease, transform .18s ease;
                }
                .ala-appbar__exit:hover,
                .ala-appbar__exit:focus{
                    color: #fff;
                    text-decoration: none;
                    background: rgba(255,255,255,.26);
                }
                .ala-appbar__exit:active{ transform: scale(.94); }
                .ala-appbar__exit:focus-visible{ outline: 2px solid #f2c14e; outline-offset: 2px; }
                .ala-appbar__exit i{ font-size: 12px; }

                @media (min-width: 768px){
                    .ala-appbar{ padding: 10px 18px; }
                    .ala-appbar__crest{ width: 44px; height: 44px; }
                    .ala-appbar__name{ font-size: 17px; }
                }
                @media (prefers-reduced-motion: reduce){
                    .ala-appbar__exit{ transition: none; }
                }
            </style>

            <div t-if="not request.env.user._is_public()" class="ala-appbar">
                <a href="/my/home" class="d-flex align-items-center flex-grow-1 gap-2 text-decoration-none"
                   style="min-width:0;">
                    <img class="ala-appbar__crest"
                         src="/ala_student_portal/static/src/img/icon.png"
                         alt="St. Anne's Convent School"/>
                    <span class="ala-appbar__titles">
                        <span class="ala-appbar__name">St. Anne's School</span>
                        <span class="ala-appbar__tag">Student Portal</span>
                    </span>
                </a>
                <a href="/web/session/logout?redirect=/web/login"
                   class="ala-appbar__exit"
                   aria-label="Sign out">
                    <i class="fa fa-sign-out" role="img"/>
                    <span>Sign out</span>
                </a>
            </div>

        </xpath>
    </template>

</odoo>