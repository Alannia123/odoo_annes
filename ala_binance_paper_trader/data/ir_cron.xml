<odoo>
    <record id="ir_cron_ala_binance_collect_market_data" model="ir.cron">
        <field name="name">ALA Binance - Collect Market Data</field>
        <field name="model_id" ref="model_ala_binance_market_snapshot"/>
        <field name="state">code</field>
        <field name="code">model.cron_collect_market_data()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_ala_binance_scan_trades" model="ir.cron">
        <field name="name">ALA Binance - Scan and Open Trades</field>
        <field name="model_id" ref="model_ala_binance_paper_trade"/>
        <field name="state">code</field>
        <field name="code">model.cron_scan_and_open_trades()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_ala_binance_manage_open_trades" model="ir.cron">
        <field name="name">ALA Binance - Manage Open Trades</field>
        <field name="model_id" ref="model_ala_binance_paper_trade"/>
        <field name="state">code</field>
        <field name="code">model.cron_manage_open_trades()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="seq_ala_binance_paper_trade" model="ir.sequence">
        <field name="name">ALA Binance Paper Trade</field>
        <field name="code">ala.binance.paper.trade</field>
        <field name="prefix">PTRADE/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>