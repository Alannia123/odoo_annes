<odoo>
    <record id="view_ala_binance_trade_journal_tree" model="ir.ui.view">
        <field name="name">ala.binance.trade.journal.tree</field>
        <field name="model">ala.binance.trade.journal</field>
        <field name="arch" type="xml">
            <list>
                <field name="trade_date"/>
                <field name="symbol"/>
                <field name="side"/>
                <field name="entry_price"/>
                <field name="exit_price"/>
                <field name="quantity"/>
                <field name="notional"/>
                <field name="pnl_amount"/>
                <field name="pnl_percent"/>
                <field name="close_reason"/>
            </list>
        </field>
    </record>

    <record id="view_ala_binance_trade_journal_pivot" model="ir.ui.view">
        <field name="name">ala.binance.trade.journal.pivot</field>
        <field name="model">ala.binance.trade.journal</field>
        <field name="arch" type="xml">
            <pivot string="Trade Journal Analysis">
                <field name="trade_date" type="row" interval="day"/>
                <field name="symbol" type="col"/>
                <field name="pnl_amount" type="measure"/>
                <field name="notional" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ala_binance_trade_journal_graph" model="ir.ui.view">
        <field name="name">ala.binance.trade.journal.graph</field>
        <field name="model">ala.binance.trade.journal</field>
        <field name="arch" type="xml">
            <graph string="Daily PnL" type="line">
                <field name="trade_date" type="row" interval="day"/>
                <field name="pnl_amount" type="measure"/>
            </graph>
        </field>
    </record>

