    <record id="action_ala_binance_trade_journal" model="ir.actions.act_window">
        <field name="name">Trade Journal</field>
        <field name="res_model">ala.binance.trade.journal</field>
        <field name="view_mode">list,pivot,graph,form</field>
    </record>

    <menuitem id="menu_ala_binance_trade_journal"
              name="Trade Journal"
              parent="menu_ala_binance_root"
              action="action_ala_binance_trade_journal"/>
