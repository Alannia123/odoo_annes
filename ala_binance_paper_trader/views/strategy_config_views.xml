<odoo>
    <record id="view_ala_binance_strategy_config_tree" model="ir.ui.view">
        <field name="name">ala.binance.strategy.config.tree</field>
        <field name="model">ala.binance.strategy.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="btc_symbol"/>
                <field name="trade_size_usdt"/>
                <field name="tp_percent"/>
                <field name="sl_percent"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ala_binance_strategy_config_form" model="ir.ui.view">
        <field name="name">ala.binance.strategy.config.form</field>
        <field name="model">ala.binance.strategy.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" invisible="state == 'running'"/>
                    <button name="action_stop" string="Stop" type="object" invisible="state != 'running'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="btc_symbol"/>
                            <field name="altcoin_symbols"/>
                            <field name="paper_capital"/>
                            <field name="trade_size_usdt"/>
                        </group>
                        <group>
                            <field name="tp_percent"/>
                            <field name="sl_percent"/>
                            <field name="btc_lookback"/>
                            <field name="alt_lookback"/>
                            <field name="use_short"/>
                            <field name="max_open_trades"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Indicator Filters">
                            <group>
                                <group string="RSI">
                                    <field name="use_rsi"/>
                                    <field name="rsi_period" invisible="not use_rsi"/>
                                    <field name="rsi_long_min" invisible="not use_rsi"/>
                                    <field name="rsi_short_max" invisible="not use_rsi"/>
                                </group>

                                <group string="MACD">
                                    <field name="use_macd"/>
                                    <field name="macd_fast" invisible="not use_macd"/>
                                    <field name="macd_slow" invisible="not use_macd"/>
                                    <field name="macd_signal" invisible="not use_macd"/>
                                </group>

                                <group string="EMA Filter">
                                    <field name="use_ema_filter"/>
                                    <field name="ema_period" invisible="not use_ema_filter"/>
                                </group>
                            </group>
                        </page>
                        <page string="Advanced Filters">
    <group>
        <group string="Trend Strength">
            <field name="use_adx"/>
            <field name="adx_period" invisible="not use_adx"/>
            <field name="adx_min" invisible="not use_adx"/>
        </group>

        <group string="Volume">
            <field name="use_volume_spike"/>
            <field name="volume_ma_period" invisible="not use_volume_spike"/>
            <field name="volume_spike_multiplier" invisible="not use_volume_spike"/>
        </group>

        <group string="ATR Stop Loss">
            <field name="use_atr_sl"/>
            <field name="atr_period" invisible="not use_atr_sl"/>
            <field name="atr_sl_multiplier" invisible="not use_atr_sl"/>
        </group>

        <group string="Risk Control">
            <field name="cooldown_minutes"/>
            <field name="max_daily_loss_percent"/>
        </group>

        <group string="Support / Resistance">
            <field name="use_sr_filter"/>
            <field name="sr_lookback" invisible="not use_sr_filter"/>
            <field name="sr_buffer_percent" invisible="not use_sr_filter"/>
        </group>

        <group string="Multi Timeframe">
            <field name="btc_timeframe"/>
            <field name="alt_timeframe"/>
        </group>
        <group string="Dashboard">
    <field name="daily_realized_pnl" readonly="1"/>
    <field name="today_trade_count" readonly="1"/>
    <field name="today_win_count" readonly="1"/>
    <field name="today_loss_count" readonly="1"/>
    <field name="equity_balance" readonly="1"/>
</group>
        <group string="Universe Selection">
    <field name="validate_symbols_on_scan"/>
    <field name="allowed_quote_asset"/>
    <field name="top_coin_limit"/>
    <field name="min_quote_volume"/>
    <field name="excluded_symbols"/>
</group>
    </group>
</page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ala_binance_strategy_config" model="ir.actions.act_window">
        <field name="name">Strategy Config</field>
        <field name="res_model">ala.binance.strategy.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ala_binance_root" name="Binance Paper Trader"/>
    <menuitem id="menu_ala_binance_strategy_config" name="Strategy Config"
              parent="menu_ala_binance_root" action="action_ala_binance_strategy_config"/>
</odoo>