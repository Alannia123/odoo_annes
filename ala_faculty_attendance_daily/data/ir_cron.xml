<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 07:30 IST = 02:00 UTC : create today's sheet with lines -->
        <record id="ir_cron_faculty_attendance_auto_create" model="ir.cron">
            <field name="name">Faculty Attendance: Auto Create Daily Sheet</field>
            <field name="model_id" ref="model_ala_faculty_attendance_sheet"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_create()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0)"/>
            <field name="active" eval="True"/>
        </record>

        <!-- 18:30 IST = 13:00 UTC : close and validate the day's sheet -->
        <record id="ir_cron_faculty_attendance_auto_close" model="ir.cron">
            <field name="name">Faculty Attendance: Auto Close (End of Day)</field>
            <field name="model_id" ref="model_ala_faculty_attendance_sheet"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_close()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).replace(hour=13, minute=0, second=0)"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
