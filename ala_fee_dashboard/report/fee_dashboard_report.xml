<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_fee_dashboard" model="report.paperformat">
        <field name="name">Fee Dashboard A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">22</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_fee_dashboard" model="ir.actions.report">
        <field name="name">Student Fee Payment Tracker</field>
        <field name="model">student.fee.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ala_fee_dashboard.report_fee_dashboard</field>
        <field name="report_file">ala_fee_dashboard.report_fee_dashboard</field>
        <field name="paperformat_id" ref="ala_fee_dashboard.paperformat_fee_dashboard"/>
        <field name="print_report_name">'Student Fee Payment Tracker'</field>
    </record>
</odoo>
