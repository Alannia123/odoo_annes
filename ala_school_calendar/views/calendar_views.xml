    <!--    Timetable period tree view-->
    <record id="school_calendar_view_tree" model="ir.ui.view">
        <field name="name">ala.school.event.view.tree</field>
        <field name="model">ala.school.event</field>
        <field name="arch" type="xml">
            <list string="School Calendar" editable="top">
                <field name="name"/>
<!--                <field name="description" />-->
                <field name="event_date" />
                <field name="is_published" widget="boolean_toggle"/>
                <field name="description" />
                <field name="is_holiday" widget="boolean_toggle"/>
                <field name="cover_image" widget="image" options="{'size': [100, 100]}"/>
            </list>
        </field>
    </record>
    <!--        Timetable period action-->
    <record id="school_calendar_action" model="ir.actions.act_window">
        <field name="name">School Calendar</field>
        <field name="res_model">ala.school.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                You haven't created any Schedules yet.
            </p>
        </field>
    </record>
    <!--    Configuration menu-->
    <menuitem
            id="education_school_calendar_root"  groups="ala_education_core.group_education_principal,ala_education_core.group_education_office_admin"
            name="Calendar" web_icon="ala_school_calendar,static/description/miscal.png"
            />
    <!--    Periods menu-->
    <menuitem
            id="education_school_calendar_menu"
            name="School Calendar"
            parent="education_school_calendar_root"
            action="school_calendar_action"/>
</odoo>
