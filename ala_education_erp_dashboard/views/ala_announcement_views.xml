<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ala_dashboard_announcement_view_list" model="ir.ui.view">
        <field name="name">ala.dashboard.announcement.view.list</field>
        <field name="model">ala.dashboard.announcement</field>
        <field name="arch" type="xml">
            <list default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="message"/>
                <field name="priority" widget="badge"
                       decoration-danger="priority == 'high'"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="create_uid" string="Published By"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ala_dashboard_announcement_view_form" model="ir.ui.view">
        <field name="name">ala.dashboard.announcement.view.form</field>
        <field name="model">ala.dashboard.announcement</field>
        <field name="arch" type="xml">
            <form string="Announcement">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="priority"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" nolabel="1"
                               placeholder="Type the announcement to run on the teachers' dashboard…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ala_dashboard_announcement_action" model="ir.actions.act_window">
        <field name="name">Teacher Announcements</field>
        <field name="res_model">ala.dashboard.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Publish an announcement for teachers
            </p>
            <p>It will scroll as a running ticker on top of the
               teacher dashboard between the display dates.</p>
        </field>
    </record>

    <menuitem id="ala_dashboard_announcement_menu"
              name="Announcements"
              parent="education_erp_dashboard_menu_root"
              action="ala_dashboard_announcement_action"
              groups="ala_education_core.group_education_principal,ala_education_core.group_education_office_admin"
              sequence="10"/>

</odoo>
