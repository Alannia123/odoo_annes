<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inheriting education student form view for adding attendance smart button-->
    <record id="education_student_view_form" model="ir.ui.view">
        <field name="name">
            ala.education.student.view.form.inherit.ala.education.attendances
        </field>
        <field name="model">ala.education.student</field>
        <field name="inherit_id"
               ref="ala_education_core.education_student_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_education_attendance_line_student"
                        type="object" class="oe_stat_button" icon="fa-calendar"
                        string="Attendance"/>
            </xpath>
        </field>
    </record>
</odoo>
