<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_ala_education_tc" model="ir.module.category">
            <field name="name">Transfer Certificate</field>
            <field name="description">Issue and manage school Transfer Certificates.</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_ala_tc_officer" model="res.groups">
            <field name="name">Officer</field>
<!--            <field name="category_id" ref="module_category_ala_education_tc"/>-->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ala_tc_manager" model="res.groups">
            <field name="name">Manager</field>
<!--            <field name="category_id" ref="module_category_ala_education_tc"/>-->
            <field name="implied_ids" eval="[(4, ref('group_ala_tc_officer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Multi-school safety: an officer only sees their own school's TCs. -->
        <record id="rule_ala_tc_company" model="ir.rule">
            <field name="name">Transfer Certificate: multi-company</field>
            <field name="model_id" ref="model_ala_transfer_certificate"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
