<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Margins are deliberately near-zero: the certificate draws its own
             decorative frame, so wkhtmltopdf must not add one of its own. -->
        <record id="paperformat_tc_a4" model="report.paperformat">
            <field name="name">Transfer Certificate A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <!-- Smart shrinking is what was scaling the certificate down to
                 ~70% of the sheet: wkhtmltopdf re-fits the viewport and every
                 mm measurement silently shrinks with it. -->
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>

    </data>
</odoo>
