<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_tc" model="ir.ui.view">
        <field name="name">res.company.form.tc</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Transfer Certificate Letterhead" name="tc_letterhead">
                    <field name="tc_school_name" placeholder="ST. ANNE'S SCHOOL"/>
                    <field name="tc_address_line1" placeholder="P.O.-Chotojagulia, P.S.- Duttapukur"/>
                    <field name="tc_address_line2" placeholder="Dist.-North 24 Parganas, Pin-743294"/>
                    <field name="tc_side_text" placeholder="ST. ANNE'S SCHOOL"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
