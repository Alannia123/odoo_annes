<odoo>

    <record id="view_import_admission_no_wizard_form" model="ir.ui.view">
    <field name="name">import.admission.no.wizard.form</field>
    <field name="model">import.admission.no.wizard</field>
    <field name="arch" type="xml">
        <form string="Import Admission No">
            <group>
                <field name="file" filename="file_name"/>
                <field name="file_name" invisible="1"/>
            </group>
            <footer>
                <button name="action_import_admission_no"
                        string="Import"
                        type="object"
                        class="btn-primary"/>
                <button string="Cancel" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="action_import_admission_no_wizard" model="ir.actions.act_window">
    <field name="name">Import Admission No</field>
    <field name="res_model">import.admission.no.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<menuitem id="menu_import_admission_no"
          name="Import Admission No"
          action="action_import_admission_no_wizard"/>

</odoo>

