<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequences for ala.education.application -->
        <record id="education_application_sequence" model="ir.sequence">
            <field name="name">Student Application</field>
            <field name="code">ala.education.application</field>
            <field name="prefix">MIS/2025-26/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Sequences for ala.education.student -->
        <record id="education_student_sequence" model="ir.sequence">
            <field name="name">Student Admission</field>
            <field name="code">ala.education.student</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences for ala.education.faculty -->
        <record id="education_faculty_sequence" model="ir.sequence">
            <field name="name">Faculty</field>
            <field name="code">ala.education.faculty</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Sequences for ala.education.document -->
        <record id="education_document_sequence" model="ir.sequence">
            <field name="name">Student Documents</field>
            <field name="code">ala.education.document</field>
            <field name="prefix">DOC/%(range_year)s/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="use_date_range"/>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Sequences for Academic Year -->
        <record id="education_academic_year_sequence" model="ir.sequence">
            <field name="name">Academic Year</field>
            <field name="code">ala.education.academic.year</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_mis_education_student_qr_token" model="ir.sequence">
            <field name="name">Student QR Token</field>
            <field name="code">mis.education.student.qr.token</field>
            <field name="prefix">STUQR/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
